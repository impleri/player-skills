{
  "schemaVersion": 1,
  "id": "playerskills",
  "version": "${version}",
  "name": "Player Skills",
  "description": "A library mod that provides a baseline implementation of player-specific skills",
  "authors": [
    "impleri"
  ],
  "contact": {
    "homepage": "https://github.com/impleri/player-skills",
    "sources": "https://github.com/impleri/player-skills",
    "issues": "https://github.com/impleri/player-skills/issues"
  },
  "license": "MIT",
  "icon": "assets/playerskills/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "scala",
        "value": "net.impleri.playerskills.fabric.PlayerSkillsFabric"
      }
    ],
    "client": [
      {
        "adapter": "scala",
        "value": "net.impleri.playerskills.client.fabric.PlayerSkillsClientFabric"
      }
    ],
    "server": [
      {
        "adapter": "scala",
        "value": "net.impleri.playerskills.server.fabric.PlayerSkillsServerFabric"
      }
    ],
    "jei_mod_plugin": [
      {
        "adapter": "scala",
        "value": "net.impleri.playerskills.integrations.jei.PlayerSkillsJeiPlugin"
      }
    ],
    "rei_client": [
      "net.impleri.playerskills.integrations.rei.PlayerSkillsReiPlugin"
    ]
  },
  "mixins": [
    "playerskills-common.mixins.json",
    "playerskills-fabric.mixins.json"
  ],
  "depends": {
    "fabric": "*",
    "fabric-language-scala": "*",
    "minecraft": "1.19.2",
    "architectury": ">=6.2.0"
  },
  "suggests": {
    "kubejs": "*",
    "crafttweaker": "*",
    "ftb-quests": ">=1902.0",
    "ftb-teams": ">=1902.0",
    "roughlyenoughitems": ">=9.0.0",
    "jei": ">=11.0.0",
    "trinkets": ">=3.5"
  }
}
